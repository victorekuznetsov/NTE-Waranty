      "height": 110,
      "styleAttributes": {},
      "text": "🔧 Коммерческий ремонт\n(оплата Полюс)",
      "color": "2"
    },
    {
      "id": "ca85f08f24006015",
      "type": "text",
      "x": 360,
      "y": 210,
      "width": 320,
      "height": 90,
      "styleAttributes": {},
      "text": "Ремонт невозможен →\nзакупка нового компонента",
