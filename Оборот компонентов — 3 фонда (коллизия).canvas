{
  "nodes": [
    {
      "id": "6992e1b8cecc6460",
      "type": "text",
      "x": -2150,
      "y": -1260,
      "width": 3050,
      "height": 130,
      "styleAttributes": {},
      "text": "ОБОРОТ КОМПОНЕНТОВ: ТРИ ФОНДА, ВЫДАЧА НА МАШИНУ И МАРШРУТ СНЯТОГО КОМПОНЕНТА В РЕМОНТ\n🔴 красным — путь снятого (неисправного) компонента к ремонту · ┈ пунктиром цвета фонда — выдача исправного на машину · сплошной цвет фонда — возврат отремонтированного в фонд"
    },
    {
      "id": "39d09a385fe782b1",
      "type": "group",
      "x": -900,
      "y": -1080,
      "width": 760,
      "height": 270,
      "styleAttributes": {},
      "label": "ЭКСПЛУАТАЦИЯ · САМОСВАЛ NHL"
    },
    {
      "id": "6c4e1b4a331feef4",
      "type": "text",
      "x": -820,
      "y": -1000,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "🚛 Компонент на самосвале\n🟢 исправный, установлен"
    },
    {
      "id": "4c8477926af528a0",
      "type": "text",
      "x": -380,
      "y": -960,
      "width": 220,
      "height": 100,
      "styleAttributes": {},
      "text": "⚠ Отказ",
      "color": "3"
    },
    {
      "id": "72232c762511b5a8",
      "type": "text",
      "x": -100,
      "y": -1000,
      "width": 320,
      "height": 150,
      "styleAttributes": {},
      "text": "🔴 Снятие\n(неисправный компонент)",
      "color": "1"
    },
    {
      "id": "4dee33070b1670d9",
      "type": "text",
      "x": -140,
      "y": -750,
      "width": 300,
      "height": 160,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "Гарантийный\nслучай?",
      "color": "3"
    },
    {
      "id": "21dec49bb978b9fe",
      "type": "group",
      "x": -2150,
      "y": -480,
      "width": 1300,
      "height": 1150,
      "styleAttributes": {},
      "label": "ГАРАНТИЙНЫЙ СЛУЧАЙ — выбор фонда  (ремонт — 🏭 единый цех ГЕ)"
    },
    {
      "id": "c330955316cbd683",
      "type": "text",
      "x": -1650,
      "y": -420,
      "width": 440,
      "height": 180,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "Закреплённый парк\nИ Фонд 3 в наличии?",
      "color": "6"
    },
    {
      "id": "a1c6be0509418eae",
      "type": "text",
      "x": -2100,
      "y": -110,
      "width": 380,
      "height": 180,
      "styleAttributes": {},
      "text": "🔧 Ремонт по гарантии\nза счёт ГЕ · 🏭 цех ГЕ",
      "color": "4"
    },
    {
      "id": "7d419bcae78a04c1",
      "type": "text",
      "x": -1650,
      "y": -110,
      "width": 380,
      "height": 180,
      "styleAttributes": {},
      "text": "🔧 Ремонт по гарантии\n(машинокомплект) · 🏭 цех ГЕ",
      "color": "6"
    },
    {
      "id": "8558e78d56c5fa4a",
      "type": "text",
      "x": -2100,
      "y": 150,
      "width": 380,
      "height": 180,
      "styleAttributes": {},
      "text": "🟢 ОФ ГЕ\nобщий гарантийный фонд\nвесь парк машин",
      "color": "4"
    },
    {
      "id": "55293008586c1964",
      "type": "text",
      "x": -1650,
      "y": 150,
      "width": 380,
      "height": 180,
      "styleAttributes": {},
      "text": "🔵 Фонд 3 — целевой клиента\nтолько закреплённый парк\nтолько гарантия",
      "color": "6"
    },
    {
      "id": "086ad27d5628888f",
      "type": "text",
      "x": -1650,
      "y": 420,
      "width": 400,
      "height": 180,
      "styleAttributes": {},
      "text": "📒 Реестр Фонда 3\nНорматив · Факт · Долг\n(заимствовано, к погашению)",
      "color": "5"
    },
    {
      "id": "ebe456cc3ceffddf",
      "type": "group",
      "x": 550,
      "y": -480,
      "width": 1050,
      "height": 650,
      "styleAttributes": {},
      "label": "НЕ ГАРАНТИЙНЫЙ СЛУЧАЙ → ОФ ПОЛЮС / ЗИП"
    },
    {
      "id": "eb40d1f307fa9ebb",
      "type": "text",
      "x": 600,
      "y": -420,
      "width": 320,
      "height": 170,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "ОФ Полюс (ЗИП)\nдоступен?",
      "color": "2"
    },
    {
      "id": "1066c788253f3b06",
      "type": "text",
      "x": 1080,
      "y": -420,
      "width": 420,
      "height": 170,
      "styleAttributes": {},
      "text": "🔧 Коммерческий ремонт\n(оплата Полюс) · 🏭 тот же цех ГЕ",
      "color": "2"
    },
    {
      "id": "01126c405a6d0065",
      "type": "text",
      "x": 1080,
      "y": -160,
      "width": 420,
      "height": 180,
      "styleAttributes": {},
      "text": "🟠 ОФ Полюс (ЗИП)\nобщий фонд владельца\nлюбые случаи",
      "color": "2"
    },
    {
      "id": "c7744a34bfe9ae51",
      "type": "group",
      "x": 550,
      "y": 220,
      "width": 2200,
      "height": 650,
      "styleAttributes": {},
      "label": "⚠ ЗОНА ИСКЛЮЧЕНИЯ (КОЛЛИЗИЯ): ОФ ПОЛЮС НЕДОСТУПЕН → ЗАИМСТВОВАНИЕ ИЗ ФОНДА 3"
    },
    {
      "id": "167e53d489cd375a",
      "type": "text",
      "x": 600,
      "y": 320,
      "width": 340,
      "height": 180,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "Одобрение\nзаимствования\nиз Фонда 3?",
      "color": "1"
    },
    {
      "id": "cf6b18fa91ea5b04",
      "type": "text",
      "x": 600,
      "y": 570,
      "width": 360,
      "height": 170,
      "styleAttributes": {},
      "text": "❌ Отказ →\nальтернатива вне ОФ\n(закупка / аренда)",
      "color": "1"
    },
    {
      "id": "8f213fbad8f961ec",
      "type": "text",
      "x": 1020,
      "y": 350,
      "width": 360,
      "height": 170,
      "styleAttributes": {},
      "text": "⚠ Заимствование\nиз Фонда 3\n(исключение)",
      "color": "6"
    },
    {
      "id": "ad13508db090b2a2",
      "type": "text",
      "x": 1460,
      "y": 350,
      "width": 360,
      "height": 170,
      "styleAttributes": {},
      "text": "Ремонт/закупка\n🏭 тот же цех ГЕ\nоплата Полюс",
      "color": "2"
    },
    {
      "id": "9358a1b707cbb2b3",
      "type": "text",
      "x": 1900,
      "y": 350,
      "width": 420,
      "height": 190,
      "styleAttributes": {},
      "text": "🔁 Погашение долга\nОБЯЗАТЕЛЬНО\nвозврат именно в Фонд 3\n(не в ЗИП!)",
      "color": "1"
    },
    {
      "id": "032751fde6ba342c",
      "type": "text",
      "x": 550,
      "y": 950,
      "width": 750,
      "height": 220,
      "styleAttributes": {},
      "text": "📐 Размер и учёт фондов\nОФ ГЕ, ОФ Полюс — норматив 10 машин = 1 комплект (λ×TAT)\nФонд 3 — норматив по контракту поставки (закреплённые машины)\nПри коллизии — обязателен учёт долга до полного погашения",
      "color": "5"
    },
    {
      "id": "93862d75ac0489e0",
      "type": "text",
      "x": 1380,
      "y": 950,
      "width": 1370,
      "height": 220,
      "styleAttributes": {},
      "text": "Обозначения линий:\n🔴 движение снятого (неисправного) компонента → к решению о гарантии → в ремонт\n┈ пунктир (цвет фонда) — выдача исправного компонента из ОФ и установка на машину\n— сплошная (цвет фонда) — возврат отремонтированного/нового компонента в фонд",
      "color": "5"
    }
  ],
