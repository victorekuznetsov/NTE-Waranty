{
  "nodes": [
    {
      "id": "69f808ebe5b34412",
      "type": "text",
      "x": -1500,
      "y": -1080,
      "width": 2900,
      "height": 110,
      "styleAttributes": {},
      "text": "ОБОРОТ КОМПОНЕНТОВ: ТРИ ФОНДА И РАЗРЕШЕНИЕ КОЛЛИЗИИ ЗАИМСТВОВАНИЯ\nОФ ГЕ (общий гарантийный) · Фонд 3 (целевой клиента, только закреплённый парк) · ОФ Полюс/ЗИП (любые случаи)"
    },
    {
      "id": "4b1e340f7da92661",
      "type": "group",
      "x": -1500,
      "y": -900,
      "width": 2900,
      "height": 240,
      "styleAttributes": {},
      "label": "ЭКСПЛУАТАЦИЯ · САМОСВАЛ NHL"
    },
    {
      "id": "9c914b7d27c36917",
      "type": "text",
      "x": -1200,
      "y": -840,
      "width": 360,
      "height": 140,
      "styleAttributes": {},
      "text": "🚛 Компонент на самосвале\n🟢 исправный, установлен"
    },
    {
      "id": "7c4f48d530913254",
      "type": "text",
      "x": -720,
      "y": -810,
      "width": 240,
      "height": 110,
      "styleAttributes": {},
      "text": "⚠ Отказ\nкомпонента",
      "color": "3"
    },
    {
      "id": "18f287514bc16b81",
      "type": "text",
      "x": -380,
      "y": -840,
      "width": 320,
      "height": 140,
      "styleAttributes": {},
      "text": "🔴 Снятие\n(неисправный компонент)",
      "color": "1"
    },
    {
      "id": "fa6a4e97c4e89c1a",
      "type": "text",
      "x": 100,
      "y": -660,
      "width": 300,
      "height": 150,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "Гарантийный\nслучай?",
      "color": "3"
    },
    {
      "id": "fa57fe58dcf82b38",
      "type": "group",
      "x": -1550,
      "y": -460,
      "width": 1500,
      "height": 900,
      "styleAttributes": {},
      "label": "ГАРАНТИЙНЫЙ СЛУЧАЙ — выбор фонда  (ремонт — 🏭 единый цех ГЕ)"
    },
    {
      "id": "c8c9d161d5040e28",
      "type": "text",
      "x": -1200,
      "y": -380,
      "width": 420,
      "height": 160,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "Закреплённый парк\nИ Фонд 3 в наличии?",
      "color": "6"
    },
    {
      "id": "808a5c804874e01e",
      "type": "text",
      "x": -1500,
      "y": -100,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "🔧 Ремонт по гарантии\nза счёт ГЕ\n🏭 цех ГЕ",
      "color": "4"
    },
    {
      "id": "79c8525a68f593b1",
      "type": "text",
      "x": -1020,
      "y": -100,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "🔧 Ремонт по гарантии\n(машинокомплект)\n🏭 цех ГЕ",
      "color": "6"
    },
    {
      "id": "12685d68827b1995",
      "type": "text",
      "x": -1500,
      "y": 140,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "🟢 ОФ ГЕ\nобщий гарантийный фонд\nвесь парк машин",
      "color": "4"
    },
    {
      "id": "e659d51d16c684b7",
      "type": "text",
      "x": -1020,
      "y": 140,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "🔵 Фонд 3 — целевой клиента\nтолько закреплённый парк\nтолько гарантия",
      "color": "6"
    },
    {
      "id": "694ada6523fd8f6f",
      "type": "text",
      "x": -540,
      "y": 140,
      "width": 400,
      "height": 150,
      "styleAttributes": {},
      "text": "📒 Реестр Фонда 3\nНорматив · Факт · Долг\n(заимствовано, к погашению)",
      "color": "5"
    },
    {
      "id": "c66e57e7f543729e",
      "type": "group",
      "x": 50,
      "y": -460,
      "width": 900,
      "height": 600,
      "styleAttributes": {},
      "label": "НЕ ГАРАНТИЙНЫЙ СЛУЧАЙ → ОФ ПОЛЮС / ЗИП"
    },
    {
      "id": "94fd1cb6ae34252b",
      "type": "text",
      "x": 100,
      "y": -380,
      "width": 320,
      "height": 160,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "ОФ Полюс (ЗИП)\nдоступен?",
      "color": "2"
    },
    {
      "id": "8a80f21fe29cb81d",
      "type": "text",
      "x": 480,
      "y": -380,
      "width": 400,
      "height": 150,
      "styleAttributes": {},
      "text": "🔧 Коммерческий ремонт\n(оплата Полюс)\n🏭 тот же цех ГЕ",
      "color": "2"
    },
    {
      "id": "88a9c6c0901dbd3e",
      "type": "text",
      "x": 480,
      "y": -140,
      "width": 400,
      "height": 150,
      "styleAttributes": {},
      "text": "🟠 ОФ Полюс (ЗИП)\nобщий фонд владельца\nлюбые случаи",
      "color": "2"
    },
    {
      "id": "338bdcc949ae8312",
      "type": "group",
      "x": -1550,
      "y": 540,
      "width": 2900,
      "height": 480,
      "styleAttributes": {},
      "label": "⚠ ЗОНА ИСКЛЮЧЕНИЯ (КОЛЛИЗИЯ): ОФ ПОЛЮС НЕДОСТУПЕН → ЗАИМСТВОВАНИЕ ИЗ ФОНДА 3"
    },
    {
      "id": "5588fbc47542c7c8",
      "type": "text",
      "x": -1450,
      "y": 660,
      "width": 340,
      "height": 170,
      "styleAttributes": {
        "shape": "diamond"
      },
      "text": "Одобрение\nзаимствования\nиз Фонда 3?",
      "color": "1"
    },
    {
      "id": "f0c731f7e8a59adc",
      "type": "text",
      "x": -1450,
      "y": 900,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "❌ Отказ →\nальтернатива вне ОФ\n(закупка / аренда)",
      "color": "1"
    },
    {
      "id": "f98f377f308c5577",
      "type": "text",
      "x": -950,
      "y": 680,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "⚠ Заимствование\nиз Фонда 3\n(исключение)",
      "color": "6"
    },
    {
      "id": "16a7a109a4a2caa0",
      "type": "text",
      "x": -480,
      "y": 680,
      "width": 360,
      "height": 150,
      "styleAttributes": {},
      "text": "Ремонт/закупка\n🏭 тот же цех ГЕ\nоплата Полюс",
      "color": "2"
    },
    {
      "id": "a562179b8cc9770f",
      "type": "text",
      "x": 20,
      "y": 680,
      "width": 420,
      "height": 170,
      "styleAttributes": {},
      "text": "🔁 Погашение долга\nОБЯЗАТЕЛЬНО\nвозврат именно в Фонд 3\n(не в ЗИП!)",
      "color": "1"
    },
    {
      "id": "7b0834b8e0845903",
      "type": "text",
      "x": 600,
      "y": 660,
      "width": 750,
      "height": 220,
      "styleAttributes": {},
      "text": "📐 Размер и учёт фондов\nОФ ГЕ, ОФ Полюс — норматив 10 машин = 1 комплект (λ×TAT)\nФонд 3 — норматив по контракту поставки (закреплённые машины)\nПри коллизии — обязателен учёт долга до полного погашения",
      "color": "5"
    }
  ],
